<odoo>
    <data>
        <record id="hr_leave_view_extend_form" model="ir.ui.view">
            <field name="name">hr.leave.view.extend.form</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
            <field name="arch" type="xml">
                <field name="request_date_to" position="replace">
                    <field name="request_date_to" class="oe_inline" invisible="request_unit_half" readonly="state not in ['draft', 'confirm']" required="not date_from or not date_to"/>
                </field>
                <field name="name" position="after">
                    <field name="is_deffered_period" readonly="1"/>
                    <field name="sick_leave_part"
                           invisible="not holiday_status_id.sick_leave"
                           readonly="state not in ['draft', 'confirm']"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
