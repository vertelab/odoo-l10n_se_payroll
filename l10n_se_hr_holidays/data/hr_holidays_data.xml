        <record id="ir_cron_update_leave_types_yearly" model="ir.cron">
            <field name="name">HR: Uppdatera semesterår</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave_type"/>
            <field name="state">code</field>
            <field name="code">model.init_records()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">12</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.today() + relativedelta(years=1, month=1, day=1, hour=2, minute=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <record model="ir.actions.server" id="action_transfer_saved_leaves_button">
            <field name="name">Överför till Sparad Semester (Årskörning)</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave_type"/>
            <field name="binding_model_id" ref="hr_holidays.model_hr_leave_type"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">
for record in records:
    record.action_transfer_to_saved_leaves()
            </field>
