        <record model="ir.actions.server" id="earn_leaves_dayes">
            <field name="name">Earn Leaves Days</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave_type"/>
            <field name="state">code</field>
            <field name="code">
                for rec in records:
                    rec.earn_leaves_days()
            </field>
        </record>
        
