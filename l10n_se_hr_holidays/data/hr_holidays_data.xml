<?xml version="1.0"?>
<odoo>
    <data noupdate="0">

        <record model="hr.work.entry.type" id="holiday_status_payed_code">
             <field name="name" eval="'Legal Leaves Payed Code'"/>
             <field name="code">sem_bet</field>
             <field name="external_code" eval="'l10n_se_hr_holidays.sem_bet'"/>
             <field name="color">2</field>
             <field name="is_leave" eval="True"/>
             <field name="country_id" ref="base.se"/>
        </record>

        <record model="hr.leave.type" id="holiday_status_cl-4">
            <field name="name" eval="'Legal Leaves '+str(DateTime.today().year - 5)" />
            <field name="work_entry_type_id" ref="l10n_se_hr_holidays.holiday_status_payed_code" />
            <field name="color">2</field>
            <field name="legal_leave" eval="True" />
            <field name="limit" eval="False" />
            <field name="date_earning_start" eval="time.strftime(str(DateTime.today().year - 6) + '-04-01')" />
            <field name="date_earning_end" eval="time.strftime(str(DateTime.today().year -5) + '-03-31')" />
        </record>

