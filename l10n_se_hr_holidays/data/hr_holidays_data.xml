        <record model="ir.actions.server" id="earn_leaves_days">
            <field name="name">Beräkna Intjänad Semester för nuvarande intjänandeår</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave_type"/>
            <field name="binding_model_id" ref="hr_holidays.model_hr_leave_type"/>
            <field name="state">code</field>
            <field name="code">
for record in records: 
    record.earn_leaves_days()
            </field>
        </record>

        <record model="ir.actions.server" id="earn_leaves_days_2022_2023">
            <field name="name">Beräkna Intjänad Semester 2022-2023</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave_type"/>
            <field name="binding_model_id" ref="hr_holidays.model_hr_leave_type"/>
            <field name="state">code</field>
            <field name="code">
start = datetime.date(2022, 4, 1)
end = datetime.date(2023, 3, 31)

for record in records: record.earn_leaves_days(forced_start=start, forced_end=end)
            </field>
        </record>

        <record model="ir.actions.server" id="earn_leaves_days_2021_2022">
