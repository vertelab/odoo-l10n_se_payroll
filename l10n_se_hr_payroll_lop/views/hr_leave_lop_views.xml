<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="hr_leave_lop_view_tree" model="ir.ui.view">
        <field name="name">hr.leave.lop.tree</field>
        <field name="model">hr.leave.lop</field>
        <field name="arch" type="xml">
            <tree string="LOP Rules" editable="bottom">
                <field name="name"/>
                <field name="leave_type"/>
                <field name="no_of_days"
                       column_invisible="parent.leave_type == 'between_holidays'"/>
                <field name="no_of_days_before"
                       column_invisible="parent.leave_type != 'between_holidays'"/>
                <field name="no_of_days_after"
                       column_invisible="parent.leave_type != 'between_holidays'"/>
                <field name="deduction_amount"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="hr_leave_lop_view_form" model="ir.ui.view">
        <field name="name">hr.leave.lop.form</field>
        <field name="model">hr.leave.lop</field>
        <field name="arch" type="xml">
            <form string="LOP Rule">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Rule Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="leave_type"/>
                            <field name="deduction_amount"/>
                        </group>
                        <group>
                            <field name="no_of_days"
                                   attrs="{'invisible': [('leave_type', '=', 'between_holidays')],
                                           'required': [('leave_type', '!=', 'between_holidays')]}"/>
                            <field name="no_of_days_before"
                                   attrs="{'invisible': [('leave_type', '!=', 'between_holidays')],
                                           'required': [('leave_type', '=', 'between_holidays')]}"/>
                            <field name="no_of_days_after"
                                   attrs="{'invisible': [('leave_type', '!=', 'between_holidays')],
                                           'required': [('leave_type', '=', 'between_holidays')]}"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="hr_leave_lop_view_search" model="ir.ui.view">
        <field name="name">hr.leave.lop.search</field>
        <field name="model">hr.leave.lop</field>
        <field name="arch" type="xml">
            <search string="Search LOP Rules">
                <field name="name"/>
                <field name="leave_type"/>
                <filter string="Active" name="active"
                        domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="hr_leave_lop_action" model="ir.actions.act_window">
        <field name="name">LOP Rules</field>
        <field name="res_model">hr.leave.lop</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure Loss of Pay rules
            </p>
            <p>
                LOP (Loss of Pay) applies when an employee takes leave on
                a day adjacent to public holidays or weekends
                ('klämdagar'). Configure when and how much to deduct.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="hr_leave_lop_menu"
              action="hr_leave_lop_action"
              parent="payroll.menu_payroll_configuration"
              name="LOP Rules"
              sequence="30"/>
</odoo>
