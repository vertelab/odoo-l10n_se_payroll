<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_payslip_action_employee" model="ir.actions.act_window">
            <field name="res_model">hr.payslip</field>
            <field name="name">Payslips</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('employee_id','=',active_id)]</field>
        </record>

        <record id="view_employee_form" model="ir.ui.view">
            <field name="name">payroll.hr.employee.view.form</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form" />
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button name="%(l10n_se_hr_payroll.hr_payslip_action_employee)d" class="oe_stat_button" icon="fa-money" type="action">
                        <field name="payslip_count" widget="statinfo" string="Payslips" />
                    </button>
                    <button name="action_view_corrections" class="oe_stat_button" icon="fa-wrench" type="object">
                        <field name="correction_count" widget="statinfo" string="Corrections"/>
                    </button>
                </div>
                <field name="birthday" position="replace">
                    <label for='birthday' />
                    <div class="o_row" name="birthday_age">
                        <field name="birthday" />
                        <span> Age </span>
                        <field name="age" class="oe_inline" />
                    </div>
                </field>
                <xpath expr="//field[@name='department_id']" position="before">
                    <field name="registration_number"/>
                </xpath>
                <xpath expr="//field[@name='job_id']" position="after">
                    <field name="nyk_id" invisible="1"/>
                </xpath>
            </field>
        </record>

        <!-- Remove original payslip button -->
        <record id="payroll_hr_employee_view_form" model="ir.ui.view">
            <field name="name">payroll.hr.employee.view.form</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="payroll.hr_employee_view_form" />
            <field name="arch" type="xml">
                <button name="%(payroll.hr_payslip_action_employee)d" position="replace" />
            </field>
        </record>

        <!-- record id="mail_activity_view_form_popup_inherit" model="ir.ui.view">
            <field name="name">mail_activity_view_form_popup_inherit</field>
            <field name="model">mail.activity</field>
            <field name="inherit_id" ref="mail.mail_activity_view_form_popup" />
            <field name="arch" type="xml">
                <field name="activity_type_id" position="after">
                </field>
            </field>
        </record -->

        <record id="hr_employee_payslip_select_view_list" model="ir.ui.view">
            <field name="name">hr.employee.payslip.select.list</field>
            <field name="model">hr.employee</field>
            <field name="arch" type="xml">
                <list string="Select Employees" expand="context.get('expand', False)" multi_edit="0" sample="1" js_class="hr_employee_list">
                    <header>
                        <button
                            name="action_generate_payslip"
                            type="object"
                            string="Generate Payslips"
                            class="oe_highlight"
                        />
                        <button
                            name="action_generate_confirmed_payslip"
                            type="object"
                            string="Generate Confirmed Payslips"
                            class="oe_highlight"
                        />
                    </header>
                    
                    <field name="name" readonly="1"/>
                    <field name="work_phone" class="o_force_ltr" readonly="1" optional="show"/>
                    <field name="work_email"/>
                    <field name="activity_ids" widget="list_activity" optional="show"/>
                    <field name="activity_user_id" optional="hide" string="Activity by" widget="many2one_avatar_user"/>
                    <field name="activity_date_deadline" widget="remaining_days" optional="show"/>
                    <field name="company_id" groups="base.group_multi_company" readonly="1" optional="show"/>
                    <field name="department_id"/>
                    <field name="job_id" context="{'default_no_of_recruitment': 0, 'default_is_favorite': False}"/>
                    <field name="parent_id" widget="many2one_avatar_user" optional="show"/>
                    <field name="address_id" column_invisible="True"/>
                    <field name="company_id" column_invisible="True"/>
                    <field name="work_location_id" optional="hide"/>
                    <field name="coach_id" widget="many2one_avatar_user" optional="hide"/>
                    <field name="active" column_invisible="True"/>
                    <field name="category_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="hide"/>
                    <field name="country_id" optional="hide"/>
                </list>
            </field>
        </record>

    </data>
</odoo>