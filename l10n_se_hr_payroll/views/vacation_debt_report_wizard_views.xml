<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_vacation_debt_report_wizard_form" model="ir.ui.view">
            <field name="name">vacation.debt.report.wizard.form</field>
            <field name="model">vacation.debt.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Semesterskuldlista">
                    <group>
                        <field name="company_id" options="{'no_create': True}"/>
                        <field name="date_to"/>
                    </group>
                    <footer>
                        <button name="action_print_report" string="Skapa rapport"
                                type="object" class="btn-primary"/>
                        <button string="Avbryt" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_vacation_debt_report_wizard" model="ir.actions.act_window">
            <field name="name">Semesterskuldlista</field>
            <field name="res_model">vacation.debt.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_vacation_debt_report" name="Semesterskuldlista"
                  parent="hr.hr_menu_hr_reports"
                  action="action_vacation_debt_report_wizard"
                  sequence="50"/>
    </data>
</odoo>
