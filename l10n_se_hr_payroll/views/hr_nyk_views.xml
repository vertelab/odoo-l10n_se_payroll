<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_hr_nyk_list" model="ir.ui.view">
            <field name="name">hr.nyk.list</field>
            <field name="model">hr.nyk</field>
            <field name="arch" type="xml">
                <list string="NYK-koder" default_order="code" import="false">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="category"/>
                    <field name="description"/>
                </list>
            </field>
        </record>

        <record id="view_hr_nyk_form" model="ir.ui.view">
            <field name="name">hr.nyk.form</field>
            <field name="model">hr.nyk</field>
            <field name="arch" type="xml">
                <form string="NYK-kod">
                    <sheet>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="category"/>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_hr_nyk_search" model="ir.ui.view">
            <field name="name">hr.nyk.search</field>
            <field name="model">hr.nyk</field>
            <field name="arch" type="xml">
                <search string="Search NYK-codes">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="category"/>
                    <filter string="Group by Category" name="group_category" context="{'group_by': 'category'}"/>
                </search>
            </field>
        </record>

        <record id="action_hr_nyk" model="ir.actions.act_window">
            <field name="name">NYK-koder</field>
            <field name="res_model">hr.nyk</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_hr_nyk_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Lägg till NYK-koder för yrkesklassificering</p>
            </field>
        </record>

        <menuitem id="menu_hr_nyk" name="NYK-koder"
                  parent="hr.menu_human_resources_configuration"
                  action="action_hr_nyk"
                  sequence="50"/>
    </data>
</odoo>
