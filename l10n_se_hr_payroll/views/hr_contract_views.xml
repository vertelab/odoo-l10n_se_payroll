<odoo>
    <record model="ir.ui.view" id="hr_contract_view_form">
        <field name="name">hr.contract.payday.field.form</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='salary']" position="inside">
                <field name="schedule_pay" invisible="1"/>
                <field name="day_of_pay" invisible="schedule_pay != 'monthly'"/>

                <separator string="Lönejusteringar" colspan="2"/>
                <field name="wage_exchange_amount"/>
                <field name="wage_exchange_start"/>
                <field name="wage_exchange_end" placeholder="Tillsvidare..."/>

                <field name="has_attachment_of_earnings"/>
                <field name="attachment_of_earnings_start" placeholder="Start Date" class="oe_inline" invisible="not has_attachment_of_earnings" required="has_attachment_of_earnings"/>
                <field name="attachment_amount" placeholder="Attachment Amount" invisible="not has_attachment_of_earnings" required="has_attachment_of_earnings"/>
                <field name="protected_amount" placeholder="Protected Amount" invisible="not has_attachment_of_earnings" required="has_attachment_of_earnings"/>    
                
                <separator string="Semester" colspan="2"/>
                <field name="vacation_days"/>
                <field name="annual_vacation_days"/>
                <field name="advance_vacation_days"/>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="hr_payroll_structure_view_form">
        <field name="name">hr.payroll.structure.const</field>
        <field name="model">hr.payroll.structure</field>
        <field name="inherit_id" ref="payroll.hr_payroll_structure_view_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="Constant" id="const">
                    <field name="const_ids">
                        <list editable="bottom">
                            <field name="name" />
                            <field name="code" />
                            <field name="constant" />
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>