<odoo>
    <record model="ir.ui.view" id="hr_contract_view_form">
        <field name="name">hr.contract.payday.field.form</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form" />
        <field name="arch" type="xml">
            <field name="schedule_pay" position="after">
                <field name="day_of_pay" invisible="schedule_pay != 'monthly'" />

                <separator string="Löneväxling" colspan="2" />
                <field name="wage_exchange_amount" />
                <field name="wage_exchange_start" />
                <field name="wage_exchange_end" placeholder="Tillsvidare..." />
                <separator colspan="2" />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="hr_payroll_structure_view_form">
        <field name="name">hr.payroll.structure.const</field>
        <field name="model">hr.payroll.structure</field>
        <field name="inherit_id" ref="payroll.hr_payroll_structure_view_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="Constant" id="const">
                    <field name="const_ids">
                        <list editable="bottom">
                            <field name="name" />
                            <field name="code" />
                            <field name="constant" />
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>