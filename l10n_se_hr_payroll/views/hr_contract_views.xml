<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Contract form: add tabs for vacation, salary adjustment, accounting -->
        <record id="view_hr_contract_form_payroll" model="ir.ui.view">
            <field name="name">hr.contract.form.payroll</field>
            <field name="model">hr.contract</field>
            <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
            <field name="arch" type="xml">
                <!-- Widen the wage row so wage_unit + wage_monthly fit -->
                <xpath expr="//div[@name='wage']" position="attributes">
                    <attribute name="class">o_row mw-100</attribute>
                </xpath>
                <!-- Replace hardcoded /month label with wage_unit + wage_monthly -->
                <xpath expr="//div[@name='wage_period_label']" position="replace">
                    <field name="wage_unit" class="oe_inline me-3" nolabel="1"/>
                    <span class="oe_inline me-1" invisible="wage_unit == 'monthly'">(</span>
                    <field name="wage_monthly" class="oe_inline" nolabel="1" invisible="wage_unit == 'monthly'"/>
                    <span class="oe_inline" invisible="wage_unit == 'monthly'">)</span>
                </xpath>
                <!-- Add payroll-specific fields after wage -->
                <xpath expr="//field[@name='wage']" position="after">
                    <field name="wage_exchange_amount" invisible="1"/>
                    <field name="wage_exchange_start" invisible="1"/>
                    <field name="wage_exchange_end" invisible="1"/>
                    <field name="has_attachment_of_earnings" invisible="1"/>
                    <field name="attachment_of_earnings_start" invisible="1"/>
                    <field name="attachment_amount" invisible="1"/>
                    <field name="protected_amount" invisible="1"/>
                    <field name="vacation_days" invisible="1"/>
                    <field name="annual_vacation_days" invisible="1"/>
                    <field name="advance_vacation_days" invisible="1"/>
                </xpath>
                <!-- Add tabs after Salary Information -->
                <xpath expr="//page[@name='information']" position="after">
                    <page string="Semester" name="vacation">
                        <group>
                            <field name="vacation_days"/>
                            <field name="annual_vacation_days"/>
                            <field name="advance_vacation_days"/>
                        </group>
                    </page>
                    <page string="Salary Adjustment" name="salary_adjustment">
                        <group string="Wage Exchange">
                            <field name="wage_exchange_amount"/>
                            <field name="wage_exchange_start"/>
                            <field name="wage_exchange_end" placeholder="Tillsvidare..."/>
                        </group>
                        <group string="Attachement of earnings">
                            <field name="has_attachment_of_earnings"/>
                            <field name="attachment_of_earnings_start"
                                   invisible="not has_attachment_of_earnings"/>
                            <field name="attachment_amount"
                                   invisible="not has_attachment_of_earnings"/>
                            <field name="protected_amount"
                                   invisible="not has_attachment_of_earnings"/>
                        </group>
                    </page>
                    <page string="Accounting" name="accounting">
                        <group>
                            <field name="journal_id"/>
                            <field name="analytic_account_id"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- Payroll structure constants -->
        <record id="view_hr_payroll_structure_const_form" model="ir.ui.view">
            <field name="name">hr.payroll.structure.const</field>
            <field name="model">hr.payroll.structure</field>
            <field name="inherit_id" ref="payroll.hr_payroll_structure_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Constants" name="const">
                        <field name="const_ids">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="code"/>
                                <field name="constant"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
