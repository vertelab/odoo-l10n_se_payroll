        </record>

        <!-- Kvalificerad övertid -->
        <!-- Övertid 2 -->
        <record id="hr_salary_rule_kval_otid" model="hr.salary.rule">
            <field name="category_id" ref="l10n_se_hr_payroll.hr_salary_rule_category_BRUTIL" />
            <field name="company_id" eval="False"/>
            <field name="code">kval_otid</field>
            <field name="name">Kvalificerad övertid (Övertid 2)</field>
            <field name="sequence">115</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = (inputs and inputs.kvaltim and inputs.kvaltim.amount_qty != 0)</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
struct_code = contract.struct_id.code
effective_wage = contract.get_full_time_wage(payslip)
KO = payslip.struct_id.get_constant('KO') # Faktor 2 för arbetare, divisor 72 för tjänstemän
MAT = payslip.struct_id.get_constant('MAT') # 173 för arbeterae, 175 för tjänstemän 

result_qty = inputs.kvaltim.amount_qty if inputs.kvaltim else 0.0

if struct_code == 'tj_tim':
    # Timanställd tjänsteman: Timlön * 175 / 72
    result = (effective_wage * MAT) / KO 
elif struct_code == 'arb_tim':
    # Timanställd arbetare: Timlön * 2.0 
    result = effective_wage * KO
elif struct_code == 'tj_man':
    # Månadsavlönad tjänsteman: Månadslön / 72
    result = effective_wage / KO
elif struct_code == 'arb_man':
    # Månadsavlönad arbetare: Månadslön / Månadsarbetstid i timmar * 2.0
    result = (effective_wage / MAT) * KO
else:
    result = effective_wage / KO
            </field>
        </record>

