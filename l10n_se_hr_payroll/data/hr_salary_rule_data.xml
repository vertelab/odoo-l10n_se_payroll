        <!-- Enkel övertid -->
        <!-- Övertid 1 -->
        <record id="hr_salary_rule_enkel_otid" model="hr.salary.rule">
            <field name="category_id" ref="l10n_se_hr_payroll.hr_salary_rule_category_BRUTIL" />
            <field name="company_id" eval="False"/>
            <field name="code">enkel_otid</field>
            <field name="name">Enkel övertid (Övertid 1)</field>
            <field name="sequence">115</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = (inputs and inputs.otidtim and inputs.otidtim.amount_qty != 0)</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
struct_code = contract.struct_id.code
effective_wage = contract.get_full_time_wage(payslip)
EO = payslip.struct_id.get_constant('EO') # Faktor 1.5 för arbetare, divisor 94 för tjänstemän
MAT = payslip.struct_id.get_constant('MAT') # 173 för arbeterae, 175 för tjänstemän 

result_qty = inputs.otidtim.amount_qty if inputs.otidtim else 0.0

if struct_code == 'tj_tim':
    # Timanställd tjänsteman: Timlön * 175 / 94
    result = (effective_wage * MAT) / EO 
elif struct_code == 'arb_tim':
    # Timanställd arbetare: Timlön * 1.5 
    result = effective_wage * EO
elif struct_code == 'tj_man':
    # Månadsavlönad tjänsteman: Månadslön / 94
    result = effective_wage / EO
elif struct_code == 'arb_man':
    # Månadsavlönad arbetare: Månadslön / Månadsarbetstid i timmar * 1.5
    result = (effective_wage / MAT) * EO
else:
    result = effective_wage / EO
            </field>
        </record>

