            <field name="company_id" eval="False"/>
            <field name="parent_rule_id" ref="hr_salary_rule_sick_leave" />
            <field name="code">sjk_lon_1590</field>
            <field name="name">Sjuklön 15-90 Tjänstemän</field>
            <field name="sequence">246</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_select">python</field>
            <field name="condition_python">
result = contract.get_sick_pay_data(payslip)['days_15_90'] &gt; 0
            </field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# Tjänsteman: 
effective_wage = contract.get_effective_wage(payslip)
PBB = payslip.struct_id.get_constant('PBB') or 483000
sick_data = contract.get_sick_pay_data(payslip)

if effective_wage &lt; 40250:
    # 10% av effective_wage per dag
    result = (effective_wage * 12 * 0.10) / 365
else:
    # 10% av PBB + 90% av belopp som är över PBB
    result = (0.10 * PBB / 365) + (0.9 * (effective_wage * 12 - PBB) / 365)

result_qty = sick_data['days_15_90']
            
            </field>
        </record>


