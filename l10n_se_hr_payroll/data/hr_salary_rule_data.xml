        <!-- Karensavdrag -->
        <record id="hr_salary_rule_qualifying_deduction" model="hr.salary.rule">
            <field name="category_id" ref="l10n_se_hr_payroll.hr_salary_rule_category_BRUAVG" />
            <field name="company_id" eval="False"/>
            <field name="parent_rule_id" ref="hr_salary_rule_sick_leave" />
            <field name="code">sjk_kar</field>
            <field name="name">Karensavdrag</field>
            <field name="sequence">242</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_python">result = contract.qualifying_count(payslip) &gt; 0</field>
            <field name="condition_select">python</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# (ML*12)/52 * 0.2 * 0.8
# (Timlön * VA) * 0.2 * 0.8 för timanställd
struct_code = contract.struct_id.code
effective_wage = (contract.wage - contract.wage_exchange_amount)
VA = payslip.struct_id.get_constant('VA')

if struct_code in ['tj_tim', 'arb_tim']:
    # Timanställd: Baseras på timlön * veckoarbetstid
    result = (effective_wage * VA) * 0.2 * 0.8 * -1
else:
    # Månadsavlönad
    result = (effective_wage * 12) / 52 * 0.2 * 0.8 * -1

result_qty = contract.qualifying_count(payslip)
            </field>
        </record>

        <!-- Avdrag dag 1 - 14 -->
        <record id="hr_salary_rule_sick_deduction_1_14" model="hr.salary.rule">
            <field name="category_id" ref="l10n_se_hr_payroll.hr_salary_rule_category_BRUAVG" />
            <field name="company_id" eval="False"/>
            <field name="parent_rule_id" ref="hr_salary_rule_sick_leave" />
            <field name="code">sjk_114</field>
            <field name="name">Sjukavdrag dag 1-14</field>
            <field name="sequence">243</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_select">python</field>
            <field name="condition_python">
result = contract.get_sick_pay_data(payslip)['hours_1_14'] &gt; 0
            </field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# (effective_wage*12)/(52*VA)
struct_code = contract.struct_id.code
effective_wage = (contract.wage - contract.wage_exchange_amount)
VA = payslip.struct_id.get_constant('VA')
sick_data = contract.get_sick_pay_data(payslip)
result_qty = sick_data['hours_1_14']

if struct_code in ['tj_tim', 'arb_tim']:
    result = effective_wage * -1
else:
    # Månadsavlönad: (effective_wage * 12) / (52 * VA)
    result = (effective_wage * 12) / (52 * VA) * -1
            </field>
