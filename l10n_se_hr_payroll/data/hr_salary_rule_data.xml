<odoo>
    <data noupdate="1">

        <!-- ===========================Grundlön & Bruttolön=========================== -->

        <record id="hr_salary_rule_gl" model="hr.salary.rule">
            <field name="category_id" ref="l10n_se_hr_payroll.hr_salary_rule_category_BAS" />
            <field name="company_id" eval="False"/>
            <field name="code">gl</field>
            <field name="name">Grundlön</field>
            <field name="sequence">10</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
if contract.struct_id.code in ['tj_tim', 'arb_tim']:
    actual_hours = contract.get_actual_work_hours(payslip)
    result_qty = actual_hours
    result = contract.wage
else:
    result_qty = 1
    result = contract.wage
            </field>
        </record>

        <record id="hr_salary_rule_brutto" model="hr.salary.rule">
            <field name="category_id" ref="l10n_se_hr_payroll.hr_salary_rule_category_BRUTTO" />
            <field name="company_id" eval="False"/>
            <field name="code">bl</field>
            <field name="name">Bruttolön</field>
            <field name="sequence">1000</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# OBS vi räknar plus på allt här då de delar som är avdrag redan är negativa tal.
result = categories.BAS + categories.BRUAVG + categories.BRUTIL
            </field>
        </record>

        <record id="hr_salary_rule_wage_exchange" model="hr.salary.rule">
            <field name="category_id" ref="l10n_se_hr_payroll.hr_salary_rule_category_BRUAVG" />
            <field name="company_id" eval="False"/>
            <field name="code">lon_vax</field>
            <field name="name">Löneväxling</field>
            <field name="sequence">11</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = contract.wage_exchange_amount &gt; 0</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
result = contract.wage_exchange_amount * -1
            </field>
        </record>

        <!-- ===========================Övertidsregler=========================== -->

        <!-- Arbetstyp -->
        <record model="hr.work.entry.type" id="work_entry_type_overtime">
            <field name="name" eval="'Övertid'"/>
            <field name="code">otid</field>
            <field name="external_code">l10n_se_hr_payroll.otid</field>
            <field name="color">2</field>
            <field name="is_leave" eval="False"/>
            <field name="country_id" ref="base.se"/>
        </record>

        <!-- Enkel övertid -->
        <!-- Övertid 1 -->
        <record id="hr_salary_rule_enkel_otid" model="hr.salary.rule">
            <field name="category_id" ref="l10n_se_hr_payroll.hr_salary_rule_category_BRUTIL" />
            <field name="company_id" eval="False"/>
            <field name="code">enkel_otid</field>
            <field name="name">Enkel övertid (Övertid 1)</field>
            <field name="sequence">115</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = (inputs and inputs.otidtim and inputs.otidtim.amount_qty != 0) or False</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
struct_code = contract.struct_id.code
effective_wage = (contract.wage - contract.wage_exchange_amount)
EO = payslip.struct_id.get_constant('EO')

result_qty = inputs.otidtim.amount_qty if inputs.otidtim else 0.0

if struct_code == 'tj':
    result = effective_wage / EO # effective_wage / 94
elif struct_code == 'arb':
    MAT = payslip.struct_id.get_constant('MAT')
    result = (effective_wage / MAT) * EO # (effective_wage / 173) * 1.5
elif struct_code in ['tj_tim', 'arb_tim']:
    result = effective_wage * EO 
else:
    result = effective_wage / EO
            
            </field>
        </record>

        <record id="hr_rule_input_otidtim" model="hr.rule.input">
            <field name="code">otidtim</field>
            <field name="name">Beordrad övertid (antal timmar)</field>
            <field name="input_id" ref="hr_salary_rule_enkel_otid" />
        </record>

        <!-- Kvalificerad övertid -->
        <!-- Övertid 2 -->
        <record id="hr_salary_rule_kval_otid" model="hr.salary.rule">
            <field name="category_id" ref="l10n_se_hr_payroll.hr_salary_rule_category_BRUTIL" />
            <field name="company_id" eval="False"/>
            <field name="code">kval_otid</field>
            <field name="name">Kvalificerad övertid (Övertid 2)</field>
            <field name="sequence">115</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = (inputs and inputs.kvaltim and inputs.kvaltim.amount_qty != 0) or False</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
struct_code = contract.struct_id.code
effective_wage = (contract.wage - contract.wage_exchange_amount)
KO = payslip.struct_id.get_constant('KO')

result_qty = inputs.kvaltim.amount_qty if inputs.kvaltim else 0.0

if struct_code == 'tj_tim':
    # Timanställd tjänsteman: Timlön * 2.0
    result = effective_wage * 2.0 
elif struct_code == 'arb_tim':
    # Timanställd arbetare: Timlön * 2.0 (om KO är 2)
    result = effective_wage * KO
elif struct_code == 'tj':
    result = effective_wage / KO
elif struct_code == 'arb':
    MAT = payslip.struct_id.get_constant('MAT')
    result = (effective_wage / MAT) * KO
else:
    result = effective_wage / KO
            </field>
        </record>

        <record id="hr_rule_input_kvaltim" model="hr.rule.input">
            <field name="code">kvaltim</field>
            <field name="name">Kvalificerad övertid (antal timmar)</field>
            <field name="input_id" ref="hr_salary_rule_kval_otid" />
        </record>


        <!-- Mertid -->
        <record id="hr_salary_rule_mertid" model="hr.salary.rule">
            <field name="category_id" ref="l10n_se_hr_payroll.hr_salary_rule_category_BRUTIL" />
