            <field name="sequence">244</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = contract.get_sick_days(payslip) if contract.get_sick_days(payslip) &gt;= 15 and worked_days.dict.get("sjk") else False</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
#(ML*12)/365
result_qty = worked_days.dict.get("sjk").number_of_days
result = (contract.wage*12)/365
            </field>
        </record>

        <!-- Sjuklön -->
        <record id="hr_salary_rule_sick_wage" model="hr.salary.rule">
            <field name="category_id" ref="l10n_se_hr_payroll.hr_salary_rule_category_BRUTIL" />
            <field name="company_id" eval="False"/>
