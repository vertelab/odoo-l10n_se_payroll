        <record id="hr_salary_rule_leave_of_absence" model="hr.salary.rule">
            <field name="category_id" ref="l10n_se_hr_payroll.hr_salary_rule_category_PARENT" />
            <field name="company_id" eval="False"/>
            <field name="code">tj_ledighet</field>
            <field name="name">Tjänstledighet</field>
            <field name="sequence">640</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_select">python</field>
            <field name="condition_python">
res = contract.split_leave_of_absence_periods(payslip)
result = res['hourly_leave_hours'] &gt; 0 or res['short_leave_days'] &gt; 0 or res['long_leave_calendar_days'] &gt; 0
            </field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# Räknar ihop total för avdrag vid tjänstledighet. Tas inte med i bruttouträkningen
result_qty = 1
v_tjl_tim = result_rules.tjl_tim.total if result_rules.tjl_tim else 0.0
v_tjl_kort = result_rules.tjl_kort.total if result_rules.tjl_kort else 0.0
v_tjl_lang = result_rules.tjl_lang.total if result_rules.tjl_lang else 0.0

result = v_tjl_tim + v_tjl_kort + v_tjl_lang
            </field>
        </record>

