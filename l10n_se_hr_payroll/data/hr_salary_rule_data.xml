            <field name="sequence">245</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_select">python</field>
            <field name="condition_python">
result = contract.get_sick_pay_data(payslip)['hours_1_14'] &gt; 0       
            </field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# (ML*12*0.8)/(52*VA)
struct_code = contract.struct_id.code
effective_wage = (contract.wage - contract.wage_exchange_amount)
VA = payslip.struct_id.get_constant('VA')
sick_data = contract.get_sick_pay_data(payslip)
result_qty = sick_data['hours_1_14']

if struct_code in ['tj_tim', 'arb_tim']:
    # Timanställd: 80% av timlönen
    result = effective_wage * 0.8
else:
    # Månadsavlönad: (ML * 12 * 0.8) / (52 * VA)
