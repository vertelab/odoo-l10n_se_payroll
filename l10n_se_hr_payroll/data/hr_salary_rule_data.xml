            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = worked_days.dict.get("sjk")</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# Räknar ihop total för avdrag/sjuklön vid sjukledighet. Tas inte med i bruttouträkningen
result_qty = 1
v_kar = result_rules.sjk_kar.total if result_rules.sjk_kar else 0.0
v_114 = result_rules.sjk_114.total if result_rules.sjk_114 else 0.0
