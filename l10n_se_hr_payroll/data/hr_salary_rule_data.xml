<!-- ===========================Grundlön & Bruttolön=========================== -->

        <record id="hr_salary_rule_gl" model="hr.salary.rule">
            <field name="category_id" ref="l10n_se_hr_payroll.hr_salary_rule_category_BAS" />
            <field name="company_id" eval="False"/>
            <field name="code">gl</field>
            <field name="name">Grundlön</field>
            <field name="sequence">10</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = contract.wage</field>
        </record>

        <record id="hr_salary_rule_brutto" model="hr.salary.rule">
            <field name="category_id" ref="l10n_se_hr_payroll.hr_salary_rule_category_BRUTTO" />
