# (ML*12)/52 * 0.2 * 0.8
# (Timlön * VA) * 0.2 * 0.8 för timanställd
effective_wage = contract.get_effective_wage(payslip)
if contract.struct_id.code in ['tj_tim', 'arb_tim']: 
    va = (contract.resource_calendar_id.full_time_required_hours * contract.resource_calendar_id.work_time_rate) / 100.0
    result = (effective_wage * va) * (0.2 * 0.8) *-1
else:
    result = (effective_wage * 12) / 52 * 0.2 * 0.8 * -1
    
result_qty = contract.qualifying_count(payslip)
            </field>
