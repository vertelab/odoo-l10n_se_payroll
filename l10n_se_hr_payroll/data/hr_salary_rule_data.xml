        <!-- Parent -->
        <record id="hr_salary_rule_sick_leave" model="hr.salary.rule">
            <field name="category_id" ref="l10n_se_hr_payroll.hr_salary_rule_category_PARENT" />
            <field name="company_id" eval="False"/>
            <field name="code">sjk_frnv</field>
            <field name="name">Sjukfrånvaro</field>
            <field name="sequence">250</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = worked_days.dict.get("sjk")</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# Räknar ihop total för avdrag/sjuklön vid sjukledighet. Tas inte med i bruttouträkningen
result_qty = 1
v_kar = result_rules.sjk_kar.total if result_rules.sjk_kar else 0.0
v_114 = result_rules.sjk_114.total if result_rules.sjk_114 else 0.0
v_1590 = result_rules.sjk_1590.total if result_rules.sjk_1590 else 0.0
v_lon = result_rules.sjk_lon.total if result_rules.sjk_lon else 0.0
result = v_kar + v_114 + v_1590 + v_lon
            </field>
        </record> 

        <!-- Karensavdrag -->
        <record id="hr_salary_rule_qualifying_deduction" model="hr.salary.rule">
            <field name="category_id" ref="l10n_se_hr_payroll.hr_salary_rule_category_BRUAVG" />
            <field name="company_id" eval="False"/>
            <field name="parent_rule_id" ref="hr_salary_rule_sick_leave" />
            <field name="code">sjk_kar</field>
            <field name="name">Karensavdrag</field>
            <field name="sequence">242</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_python">result = contract.qualifying_count(payslip)</field>
            <field name="condition_select">python</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# (ML*12)/52 * 0.2 * 0.8
result = (contract.wage*12)/52 * 0.2 * 0.8 * -1
result_qty = contract.qualifying_count(payslip)
            </field>
        </record>

        <!-- Avdrag dag 1 - 14 -->
        <record id="hr_salary_rule_sick_deduction_1_14" model="hr.salary.rule">
            <field name="category_id" ref="l10n_se_hr_payroll.hr_salary_rule_category_BRUAVG" />
            <field name="company_id" eval="False"/>
            <field name="parent_rule_id" ref="hr_salary_rule_sick_leave" />
            <field name="code">sjk_114</field>
            <field name="name">Sjukavdrag dag 1-14</field>
            <field name="sequence">243</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = contract.get_sick_days(payslip) if contract.get_sick_days(payslip) &lt;= 14 and worked_days.dict.get("sjk") else False</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# (ML*12)/(52*VA)
VA = payslip.struct_id.get_constant('VA')
result_qty = worked_days.dict.get("sjk").number_of_hours
result = (contract.wage*12)/(52*VA)
            </field>
        </record>

        <!-- Avdrag dag 15 - 90 -->
        <record id="hr_salary_rule_sick_deduction_15_90" model="hr.salary.rule">
            <field name="category_id" ref="l10n_se_hr_payroll.hr_salary_rule_category_BRUAVG" />
            <field name="company_id" eval="False"/>
            <field name="parent_rule_id" ref="hr_salary_rule_sick_leave" />
