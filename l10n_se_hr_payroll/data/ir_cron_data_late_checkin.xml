<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Daily cron job to detect late check-ins and create records -->
    <record id="ir_cron_late_check_in" model="ir.cron">
        <field name="name">Attendance: Late Check-in Detection</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="state">code</field>
        <field name="code">model._cron_late_check_in_records()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
