        <record id="hr_salary_rule_trakt_parent" model="hr.salary.rule">
            <field name="category_id" ref="l10n_se_hr_payroll.hr_salary_rule_category_PARENT" />
            <field name="company_id" eval="False"/>
            <field name="code">trakt_grp</field>
            <field name="name">Traktamente och kost (totalt netto)</field>
            <field name="sequence">79</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_select">python</field>
            <field name="condition_python">
result = (inputs.trakt_hel and inputs.trakt_hel.amount_qty &gt; 0) or \
         (inputs.trakt_halv and inputs.trakt_halv.amount_qty &gt; 0) or \
         (inputs.trakt_natt and inputs.trakt_natt.amount_qty &gt; 0) or \
         (inputs.trakt_skatt and inputs.trakt_skatt.amount_qty &gt; 0) or \
         (inputs.fmn_frukost and inputs.fmn_frukost.amount_qty &gt; 0) or \
         (inputs.fmn_lunch and inputs.fmn_lunch.amount_qty &gt; 0) or \
         (inputs.fmn_fri and inputs.fmn_fri.amount_qty &gt; 0) or \
         (inputs.red_frukost and inputs.red_frukost.amount_qty &gt; 0) or \
         (inputs.red_lunch and inputs.red_lunch.amount_qty &gt; 0) or \
         (inputs.red_fri and inputs.red_fri.amount_qty &gt; 0) or \
         (inputs.red_utl_frukost and inputs.red_utl_frukost.amount_qty &gt; 0) or \
         (inputs.red_utl_lunch and inputs.red_utl_lunch.amount_qty &gt; 0) or \
         (inputs.red_utl_fri and inputs.red_utl_fri.amount_qty &gt; 0) or \
         (inputs.trakt_fi and inputs.trakt_fi.amount_qty &gt; 0) or \
         (inputs.trakt_fr and inputs.trakt_fr.amount_qty &gt; 0) or \
         (inputs.trakt_no and inputs.trakt_no.amount_qty &gt; 0) or \
         (inputs.trakt_es and inputs.trakt_es.amount_qty &gt; 0) or \
         (inputs.trakt_de and inputs.trakt_de.amount_qty &gt; 0) or \
         (inputs.trakt_us and inputs.trakt_us.amount_qty &gt; 0)
            </field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
v_hel = result_rules.trakt_hel.total if result_rules.trakt_hel else 0.0
v_halv = result_rules.trakt_halv.total if result_rules.trakt_halv else 0.0
v_natt = result_rules.trakt_natt.total if result_rules.trakt_natt else 0.0

v_fi = result_rules.trakt_fi.total if result_rules.trakt_fi else 0.0
v_fr = result_rules.trakt_fr.total if result_rules.trakt_fr else 0.0
v_no = result_rules.trakt_no.total if result_rules.trakt_no else 0.0
v_es = result_rules.trakt_es.total if result_rules.trakt_es else 0.0
v_de = result_rules.trakt_de.total if result_rules.trakt_de else 0.0
v_us = result_rules.trakt_us.total if result_rules.trakt_us else 0.0

v_red_frukost = result_rules.trakt_red_frukost.total if result_rules.trakt_red_frukost else 0.0
v_red_lunch = result_rules.trakt_red_lunch.total if result_rules.trakt_red_lunch else 0.0
v_red_fri = result_rules.trakt_red_fri.total if result_rules.trakt_red_fri else 0.0

v_red_utl_frukost = result_rules.trakt_red_utl_frukost.total if result_rules.trakt_red_utl_frukost else 0.0
v_red_utl_lunch = result_rules.trakt_red_utl_lunch.total if result_rules.trakt_red_utl_lunch else 0.0
v_red_utl_fri = result_rules.trakt_red_utl_fri.total if result_rules.trakt_red_utl_fri else 0.0

result = v_hel + v_halv + v_natt + v_fi + v_fr + v_no + v_es + v_de + v_us + v_red_frukost + \
         v_red_lunch + v_red_fri + v_red_utl_frukost + v_red_utl_lunch + v_red_utl_fri
            </field>
        </record>

