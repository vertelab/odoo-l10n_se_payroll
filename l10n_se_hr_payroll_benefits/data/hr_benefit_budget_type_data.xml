<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Friskvårdsbidrag -->
        <record id="budget_type_fitness" model="hr.benefit.budget.type">
            <field name="name">Friskvårdsbidrag</field>
            <field name="code">fitness</field>
            <field name="sequence">10</field>
            <field name="max_amount">5000</field>
            <field name="note">
Skattefritt friskvårdsbidrag enligt Skatteverket.
Gäller enklare motion som gym, simning, massage, etc.
Max 5 000 kr/år per anställd. Kräver kvitto.
            </field>
        </record>

        <!-- Bilvårdsbudget -->
        <record id="budget_type_car_care" model="hr.benefit.budget.type">
            <field name="name">Bilvårdsbudget</field>
            <field name="code">car_care</field>
            <field name="sequence">20</field>
            <field name="max_amount">12000</field>
            <field name="note">
Budget för anställd med tjänstebil som ansvarar för skötsel.
Täcker service, däckbyte, tvätt, reparationer.
Utlägg redovisas mot budgeten.
            </field>
        </record>

        <!-- Kompetensutveckling -->
        <record id="budget_type_education" model="hr.benefit.budget.type">
            <field name="name">Kompetensutveckling</field>
            <field name="code">education</field>
            <field name="sequence">30</field>
            <field name="max_amount">15000</field>
            <field name="note">
Budget för kurser, konferenser, böcker och annan kompetensutveckling.
Utlägg redovisas mot budgeten.
            </field>
        </record>

    </data>
</odoo>
