<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- hr.benefit tree view -->
        <record id="view_hr_benefit_tree" model="ir.ui.view">
            <field name="name">hr.benefit.tree</field>
            <field name="model">hr.benefit</field>
            <field name="arch" type="xml">
                <list string="Förmånstyper" editable="bottom">
                    <field name="name"/>
                    <field name="desc"/>
                    <field name="category" widget="badge"/>
                    <field name="code_id"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- hr.benefit form view -->
        <record id="view_hr_benefit_form" model="ir.ui.view">
            <field name="name">hr.benefit.form</field>
            <field name="model">hr.benefit</field>
            <field name="arch" type="xml">
                <form string="Förmånstyp">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="desc"/></h1>
                        </div>
                        <group>
                            <field name="name"/>
                            <field name="category"/>
                            <field name="active"/>
                        </group>
                        <group string="Koppling till löneregel">
                            <field name="code_id"
                                   domain="[('category_id.code', '=', 'FORMAN')]"/>
                        </group>
                        <group string="Notering">
                            <field name="note" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- hr.benefit search view -->
        <record id="view_hr_benefit_search" model="ir.ui.view">
            <field name="name">hr.benefit.search</field>
            <field name="model">hr.benefit</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="desc"/>
                    <filter name="active" string="Aktiva"
                            domain="[('active', '=', True)]"/>
                    <filter name="category_vehicle" string="Bil"
                            domain="[('category', '=', 'vehicle')]"/>
                    <filter name="category_housing" string="Bostad"
                            domain="[('category', '=', 'housing')]"/>
                    <filter name="category_meal" string="Måltider"
                            domain="[('category', '=', 'meal')]"/>
                    <group expand="0" string="Kategori">
                        <filter name="cat_vehicle" string="Bil / Motorfordon"
                                domain="[('category', '=', 'vehicle')]"/>
                        <filter name="cat_housing" string="Bostad"
                                domain="[('category', '=', 'housing')]"/>
                        <filter name="cat_meal" string="Måltider"
                                domain="[('category', '=', 'meal')]"/>
                        <filter name="cat_travel" string="Resor"
                                domain="[('category', '=', 'travel')]"/>
                        <filter name="cat_other" string="Övrigt"
                                domain="[('category', '=', 'other')]"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- hr.benefit action -->
        <record id="action_hr_benefit" model="ir.actions.act_window">
            <field name="name">Förmånstyper</field>
            <field name="res_model">hr.benefit</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_hr_benefit_search"/>
        </record>

        <!-- Contract form: add benefits tab -->
        <record id="view_hr_contract_form_benefits" model="ir.ui.view">
            <field name="name">hr.contract.form.benefits</field>
            <field name="model">hr.contract</field>
            <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Förmåner" name="benefits">
                        <group invisible="not benefit_summary">
                            <field name="benefit_summary" nolabel="1"
                                   colspan="2"/>
                        </group>
                        <field name="benefit_ids">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="desc"/>
                                <field name="value" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"/>
                                <field name="date_start"/>
                                <field name="date_end"/>
                                <field name="note"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- ============================================ -->
        <!-- BUDGET FÖRMÅNER (Friskvård, etc)            -->
        <!-- ============================================ -->

        <!-- hr.benefit.budget list view -->
        <record id="view_hr_benefit_budget_list" model="ir.ui.view">
            <field name="name">hr.benefit.budget.list</field>
            <field name="model">hr.benefit.budget</field>
            <field name="arch" type="xml">
                <list string="Förmånsbudgetar">
                    <field name="name"/>
                    <field name="year"/>
                    <field name="max_amount" widget="monetary"
                           options="{'currency_field': 'currency_id'}"/>
                    <field name="salary_rule_id"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- hr.benefit.budget form view -->
        <record id="view_hr_benefit_budget_form" model="ir.ui.view">
            <field name="name">hr.benefit.budget.form</field>
            <field name="model">hr.benefit.budget</field>
            <field name="arch" type="xml">
                <form string="Förmånsbudget">
                    <header>
                        <button name="action_generate_lines" type="object"
                                string="Generera anställdas rader"
                                class="btn-primary"/>
                        <button name="action_recompute_used" type="object"
                                string="Uppdatera utnyttjat"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <field name="type_id"/>
                            <field name="code"/>
                            <field name="year"/>
                            <field name="max_amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="salary_rule_id"/>
                            <field name="active"/>
                        </group>
                        <group string="Anställdas budget">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="employee_id"
                                           widget="many2one_avatar_employee"/>
                                    <field name="allocated_amount" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="used_amount" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="remaining_amount" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                </list>
                            </field>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- hr.benefit.budget action -->
        <record id="action_hr_benefit_budget" model="ir.actions.act_window">
            <field name="name">Förmånsbudgetar</field>
            <field name="res_model">hr.benefit.budget</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Employee form: add budget tab -->
        <record id="view_hr_employee_form_budget" model="ir.ui.view">
            <field name="name">hr.employee.form.budget</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='hr_settings']" position="after">
                    <page string="Förmånsbudget" name="benefit_budget">
                        <field name="benefit_budget_line_ids">
                            <list>
                                <field name="budget_id"/>
                                <field name="allocated_amount" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"/>
                                <field name="used_amount" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"/>
                                <field name="remaining_amount" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- Budget generate wizard -->
        <record id="view_hr_benefit_budget_generate_form" model="ir.ui.view">
            <field name="name">hr.benefit.budget.generate.form</field>
            <field name="model">hr.benefit.budget.generate</field>
            <field name="arch" type="xml">
                <form string="Generate Benefit Budget">
                    <sheet>
                        <div class="oe_title"><h1>Generate Benefit Budget</h1></div>
                        <group>
                            <field name="type_id"/>
                            <field name="year"/>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="max_amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="salary_rule_id"/>
                        </group>
                        <group string="Select Employees">
                            <field name="department_id"
                                   placeholder="Filter by department..."/>
                            <field name="job_id"
                                   placeholder="Filter by job..."/>
                            <field name="filter_benefit_id"
                                   placeholder="Filter by contract benefit..."/>
                            <field name="employee_ids" widget="many2many_tags"
                                   placeholder="Employees (auto-filled from filter)"/>
                        </group>
                        <group string="Preview">
                            <field name="preview_text" nolabel="1" colspan="2"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_generate"
                                string="Generate"
                                type="object" class="btn-primary"
                                confirm="Create budget lines for selected employees?"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_hr_benefit_budget_generate" model="ir.actions.act_window">
            <field name="name">Generate Benefit Budget</field>
            <field name="res_model">hr.benefit.budget.generate</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Menus -->
        <menuitem id="menu_hr_benefit_budget"
                  name="Benefit Budgets"
                  parent="payroll.payroll_menu_configuration"
                  action="action_hr_benefit_budget"
                  sequence="22"/>

        <menuitem id="menu_hr_benefit_budget_generate"
                  name="Generate Budget"
                  parent="menu_hr_benefit_budget"
                  action="action_hr_benefit_budget_generate"
                  sequence="10"/>

        <menuitem id="menu_hr_benefit"
                  name="Förmånstyper"
                  parent="payroll.payroll_menu_configuration"
                  action="action_hr_benefit"
                  sequence="25"/>

    </data>
</odoo>
