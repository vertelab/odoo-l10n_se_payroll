<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_company_form_inherit_arbetsgivarintyg" model="ir.ui.view">
            <field name="name">res.company.form.inherit.arbetsgivarintyg</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Arbetsgivarintyg.nu" name="arbetsgivarintyg_config"
                          groups="payroll.group_payroll_manager">
                        <group>
                            <field name="arbetsgivarintyg_test_mode"/>
                            <field name="arbetsgivarintyg_api_url" readonly="1"/>
                            <field name="arbetsgivarintyg_api_nyckel"/>
                            <field name="arbetsgivarintyg_arbetsgivar_id"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
