<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- =============================================================
        Form view
        ============================================================= -->
        <record id="view_fora_declaration_form" model="ir.ui.view">
            <field name="name">fora.declaration.form</field>
            <field name="model">account.fora.declaration</field>
            <field name="arch" type="xml">
                <form string="FORA-premier">
                    <header>
                        <button class="oe_highlight"
                            invisible="state not in ['draft']"
                            name="calculate" string="Beräkna" type="object"/>
                        <button class="oe_highlight"
                            invisible="state not in ['confirmed','done'] or skv_api_status not in ['draft','error']"
                            name="action_send_to_fora"
                            string="Skicka till FORA" type="object"/>
                        <button class="oe_highlight"
                            invisible="state not in ['done','confirmed','canceled']"
                            name="do_draft" string="Draft" type="object"/>
                        <button class="oe_highlight"
                            invisible="state not in ['confirmed']"
                            name="do_done" string="Done" type="object"/>
                        <button class="oe_highlight"
                            invisible="state not in ['confirmed','done']"
                            name="do_cancel" string="Cancel" type="object"/>
                        <field name="state" widget="statusbar"/>
                        <field name="skv_api_status"
                            invisible="skv_api_status == 'draft'"
                            widget="badge"
                            decoration-success="skv_api_status == 'accepted'"
                            decoration-danger="skv_api_status == 'error'"
                            decoration-warning="skv_api_status == 'submitted'"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" icon="fa-users"
                                name="action_view_payslips" type="object"
                                help="Visa lönespecar i denna lönekörning">
                                <div class="o_form_field o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="employee_count"/>
                                    </span>
                                    <span class="o_stat_text">Anställda</span>
                                </div>
                            </button>
                            <button class="oe_stat_button" icon="fa-file-text-o"
                                name="action_view_agreement" type="object"
                                invisible="state == 'draft'"
                                help="Visa kollektivavtal">
                                <span>Kollektivavtal</span>
                            </button>
                            <button class="oe_stat_button" icon="fa-download"
                                name="action_download_fora_file" type="object"
                                string="Ladda ner"
                                invisible="state == 'draft' or not fora_file"
                                help="Ladda ner FORA-fil (XML)"/>
                            <button class="oe_stat_button" icon="fa-calendar"
                                name="action_open_calendar_event" type="object"
                                string="Kalender" invisible="not event_id"
                                help="Öppna kalenderhändelse för deadline"/>
                            <button class="oe_stat_button" icon="fa-external-link"
                                invisible="not fora_case_number"
                                string="FORA Ärende"
                                help="FORA ärendenummer">
                                <div class="o_form_field o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="fora_case_number"/>
                                    </span>
                                </div>
                            </button>
                        </div>

                        <div class="oe_title">
                            <label class="oe_edit_only" for="name"/>
                            <h1><field name="name"/></h1>
                        </div>

                        <group>
                            <group>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="payslip_run_id"
                                    domain="[('state', '=', 'done')]"
                                    readonly="not state"
                                    string="Lönekörning"/>
                                <field name="fora_report_type"
                                    readonly="state != 'draft'"
                                    string="Rapporttyp"/>
                                <field name="date"/>
                            </group>
                            <group>
                                <field name="date_start" string="Period fr.o.m."
                                    widget="daterange"
                                    options="{'end_date_field': 'date_stop'}"
                                    readonly="state != 'draft'"/>
                                <field name="date_stop" invisible="1"/>
                                <field name="fora_submitted_date"
                                    invisible="not fora_submitted_date"/>
                            </group>
                        </group>

                        <group string="Sammanfattning premier">
                            <group>
                                <field name="total_wage_basis" widget="monetary"
                                    string="Total lönebas"/>
                                <field name="total_tgl_premium" widget="monetary"
                                    string="TGL-premie"/>
                                <field name="total_tfa_premium" widget="monetary"
                                    string="TFA-premie"/>
                            </group>
                            <group>
                                <field name="total_ags_premium" widget="monetary"
                                    string="AGS-premie"/>
                                <field name="total_agb_premium" widget="monetary"
                                    string="AGB-premie"/>
                                <field name="total_pension_premium" widget="monetary"
                                    string="Pensionspremie"/>
                                <field name="total_premium" widget="monetary"
                                    string="Total premie totalt"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Inställningar">
                                <group>
                                    <field name="target_move" readonly="state != 'draft'"/>
                                    <field name="fora_file" filename="fora_file_name" invisible="1"/>
                                    <field name="fora_file_name" invisible="1"/>
                                </group>
                            </page>

                            <page string="Anställda">
                                <field name="line_ids" nolabel="1">
                                    <list create="0" delete="0" edit="0"
                                        default_order="collective_agreement_id,employee_id">
                                        <field name="employee_id"/>
                                        <field name="personal_number"/>
                                        <field name="collective_agreement_id"/>
                                        <field name="pension_type"/>
                                        <field name="age_group"/>
                                        <field name="wage_basis" sum="Total lönebas"/>
                                        <field name="tgl_premium" sum="TGL"/>
                                        <field name="tfa_premium" sum="TFA"/>
                                        <field name="ags_premium" sum="AGS"/>
                                        <field name="pension_premium" sum="Pension"/>
                                        <field name="total_premium" sum="Total premie"/>
                                    </list>
                                </field>
                            </page>

                            <page string="Detaljer">
                                <field name="line_ids" nolabel="1">
                                    <list create="0" delete="0" edit="0"
                                        default_order="collective_agreement_id,employee_id">
                                        <field name="employee_id"/>
                                        <field name="personal_number"/>
                                        <field name="collective_agreement_id"/>
                                        <field name="pension_type"/>
                                        <field name="age_group"/>
                                        <field name="wage_basis"/>
                                        <field name="tgl_premium"/>
                                        <field name="tfa_premium"/>
                                        <field name="ags_premium"/>
                                        <field name="agb_premium"/>
                                        <field name="pension_wage_basic"/>
                                        <field name="pension_wage_high"/>
                                        <field name="pension_wage_low"/>
                                        <field name="pension_wage_mid"/>
                                        <field name="pension_premium"/>
                                        <field name="total_premium"/>
                                    </list>
                                </field>
                            </page>

                            <page string="Upplysningstext">
                                <field name="free_text" nolabel="1"
                                    readonly="state != 'draft'"/>
                            </page>

                            <page string="FORA API"
                                invisible="skv_api_status == 'draft' and not skv_response">
                                <group>
                                    <field name="skv_api_status"/>
                                    <field name="fora_submitted_date"/>
                                    <field name="fora_case_number"/>
                                    <field name="skv_response" nolabel="1"
                                        invisible="skv_api_status != 'error'"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- =============================================================
        Search view
        ============================================================= -->
        <record id="view_fora_filter" model="ir.ui.view">
            <field name="name">fora.declaration.filter</field>
            <field name="model">account.fora.declaration</field>
            <field name="arch" type="xml">
                <search string="Search FORA">
                    <field name="name"/>
                    <field name="date_start"/>
                    <field name="date_stop"/>
                    <field name="date" string="Deadline"/>
                    <field name="fora_case_number" string="FORA Ärende"/>
                    <field name="state"/>
                    <separator/>
                    <filter name="draft" string="Utkast"
                        domain="[('state', '=', 'draft')]"/>
                    <filter name="confirmed" string="Bekräftade"
                        domain="[('state', '=', 'confirmed')]"/>
                    <filter name="done" string="Klara"
                        domain="[('state', '=', 'done')]"/>
                    <separator/>
                    <filter name="monthly" string="Månadsrapport"
                        domain="[('fora_report_type', '=', 'monthly')]"/>
                    <filter name="quarterly" string="Kvartalsrapport"
                        domain="[('fora_report_type', '=', 'quarterly')]"/>
                    <filter name="annual" string="Årsrapport"
                        domain="[('fora_report_type', '=', 'annual')]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter context="{'group_by': 'state'}"
                            name="group_state" string="State"/>
                        <filter context="{'group_by': 'date_start'}"
                            name="group_period" string="Period"/>
                        <filter context="{'group_by': 'fora_report_type'}"
                            name="group_type" string="Rapporttyp"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- =============================================================
        List view
        ============================================================= -->
        <record id="view_fora_tree" model="ir.ui.view">
            <field name="name">fora.declaration.tree</field>
            <field name="model">account.fora.declaration</field>
            <field name="arch" type="xml">
                <list string="FORA-premier">
                    <field name="name"/>
                    <field name="date"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="date_start"/>
                    <field name="date_stop"/>
                    <field name="fora_report_type"/>
                    <field name="employee_count"/>
                    <field name="total_premium" widget="monetary"/>
                    <field name="state"/>
                    <field name="skv_api_status" widget="badge"
                        decoration-success="skv_api_status == 'accepted'"
                        decoration-danger="skv_api_status == 'error'"/>
                    <field name="fora_case_number" optional="show"/>
                </list>
            </field>
        </record>

        <!-- =============================================================
        Calendar view
        ============================================================= -->
        <record id="view_fora_calendar" model="ir.ui.view">
            <field name="name">fora.declaration.calendar</field>
            <field name="model">account.fora.declaration</field>
            <field name="arch" type="xml">
                <calendar date_start="date" string="FORA">
                    <field name="name"/>
                    <field name="date_start"/>
                    <field name="fora_report_type"/>
                    <field name="state"/>
                </calendar>
            </field>
        </record>

        <!-- =============================================================
        Action + Menu
        ============================================================= -->
        <record id="action_fora_declaration" model="ir.actions.act_window">
            <field name="name">FORA-premier</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">account.fora.declaration</field>
            <field name="view_mode">list,form,calendar</field>
            <field name="search_view_id" ref="view_fora_filter"/>
        </record>

        <!-- Place under the same authorities menu as AGD -->
        <menuitem action="action_fora_declaration"
                  id="menu_fora_declaration"
                  name="FORA-premier"
                  parent="l10n_se_tax_report.menu_report_authorities"
                  sequence="15"/>

    </data>
</odoo>
