<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Weekly sync of Swedish tax tables from Skatteverket.
             Tax tables are published annually (Dec/Jan). Running weekly
             ensures new tables are picked up quickly while keeping overhead
             low — most runs are no-ops since existing lines are skipped. -->
        <record id="ir_cron_sync_taxtable" model="ir.cron">
            <field name="name">Payroll: Sync Swedish Tax Tables (Skatteverket)</field>
            <field name="model_id" ref="l10n_se_payroll_taxtable.model_payroll_taxtable"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_all_taxtables()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="priority">10</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
