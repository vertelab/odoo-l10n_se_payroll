<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- =============================================================
        Form view
        ============================================================= -->
        <record id="view_vaxa_support_form" model="ir.ui.view">
            <field name="name">vaxa.support.form</field>
            <field name="model">account.vaxa.support</field>
            <field name="arch" type="xml">
                <form string="Växa-stöd">
                    <header>
                        <button class="oe_highlight"
                            invisible="state not in ['draft']"
                            name="calculate" string="Beräkna" type="object"/>
                        <button class="oe_highlight"
                            invisible="state not in ['confirmed','done'] or skv_api_status not in ['draft','error']"
                            name="action_send_to_skv" string="Skicka till Skatteverket" type="object"/>
                        <button class="oe_highlight"
                            invisible="state not in ['done','confirmed','canceled']"
                            name="do_draft" string="Utkast" type="object"/>
                        <button class="oe_highlight"
                            invisible="state not in ['confirmed']"
                            name="do_done" string="Klar" type="object"/>
                        <button class="oe_highlight"
                            invisible="state not in ['confirmed','done']"
                            name="do_cancel" string="Avbryt" type="object"/>
                        <field name="state" widget="statusbar"/>
                        <field name="skv_api_status"
                            invisible="skv_api_status == 'draft'"
                            widget="badge"
                            decoration-success="skv_api_status == 'accepted'"
                            decoration-danger="skv_api_status == 'error'"
                            decoration-warning="skv_api_status == 'submitted'"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" icon="fa-users"
                                name="action_view_payslips" type="object"
                                help="Visa lönespecar i denna lönekörning">
                                <div class="o_form_field o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="employee_count"/>
                                    </span>
                                    <span class="o_stat_text">Anställda</span>
                                </div>
                            </button>
                            <button class="oe_stat_button" icon="fa-download"
                                name="action_download_vaxa_file" type="object"
                                string="Ladda ner"
                                invisible="state == 'draft' or not vaxa_file"
                                help="Ladda ner växa-stöd-fil för manuell inlämning"/>
                            <button class="oe_stat_button" icon="fa-calendar"
                                name="action_open_calendar_event" type="object"
                                string="Kalender" invisible="not event_id"
                                help="Öppna kalenderhändelse för deadline"/>
                        </div>

                        <div class="oe_title">
                            <label class="oe_edit_only" for="name"/>
                            <h1><field name="name"/></h1>
                        </div>

                        <group>
                            <group>
                                <field name="company_id"
                                    groups="base.group_multi_company"/>
                                <field name="payslip_run_id"
                                    domain="[('state', '=', 'done')]"
                                    readonly="not state and not payslip_run_id"
                                    string="Lönekörning"/>
                                <field name="agd_declaration_id"
                                    domain="[('state', '=', 'done')]"
                                    readonly="not state and not agd_declaration_id"
                                    string="AGD-deklaration"/>
                            </group>
                            <group>
                                <field name="date" string="Deadline"/>
                                <field name="date_start" string="Period fr.o.m."
                                    widget="daterange"
                                    options="{'end_date_field': 'date_stop'}"
                                    readonly="not state and not date_start"/>
                                <field name="date_stop" invisible="1"/>
                                <field name="application_deadline"
                                    string="Sista ansökningsdag"/>
                            </group>
                        </group>

                        <group string="Sammanfattning">
                            <group>
                                <field name="total_salary" widget="monetary"
                                    string="Total bruttolön"/>
                                <field name="total_reimbursement" widget="monetary"
                                    string="Total återbetalning"/>
                            </group>
                            <group>
                                <field name="employee_count"
                                    string="Antal anställda"/>
                                <field name="total_de_minimis_eur" widget="monetary"
                                    string="Totalt de minimis (SEK)"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Anställda">
                                <field name="line_ids" nolabel="1">
                                    <list create="0" delete="0" edit="0"
                                        default_order="employee_id">
                                        <field name="employee_id"/>
                                        <field name="personal_number"/>
                                        <field name="employee_number"/>
                                        <field name="monthly_salary"
                                            sum="Total bruttolön"/>
                                        <field name="salary_cap"/>
                                        <field name="basis_for_support"
                                            sum="Totalt underlag"/>
                                        <field name="reimbursement_amount"
                                            sum="Total återbetalning"/>
                                        <field name="months_used"/>
                                        <field name="months_remaining"/>
                                    </list>
                                </field>
                            </page>

                            <page string="Detaljer">
                                <field name="line_ids" nolabel="1">
                                    <list create="0" delete="0" edit="0"
                                        default_order="employee_id">
                                        <field name="employee_id"/>
                                        <field name="personal_number"/>
                                        <field name="employee_number"/>
                                        <field name="hire_date"/>
                                        <field name="monthly_salary"/>
                                        <field name="salary_cap"/>
                                        <field name="basis_for_support"/>
                                        <field name="reimbursement_amount"/>
                                        <field name="months_used"/>
                                        <field name="months_remaining"/>
                                        <field name="de_minimis_used"/>
                                    </list>
                                </field>
                            </page>

                            <page string="Inställningar">
                                <group>
                                    <field name="target_move"
                                        readonly="not state"/>
                                    <field name="vaxa_file"
                                        filename="vaxa_file_name" invisible="1"/>
                                    <field name="vaxa_file_name" invisible="1"/>
                                </group>
                            </page>

                            <page string="Upplysningstext">
                                <field name="free_text" nolabel="1"
                                    readonly="not state"/>
                            </page>

                            <page string="Skatteverket API"
                                invisible="skv_api_status == 'draft' and not skv_response">
                                <group>
                                    <field name="skv_api_status"/>
                                    <field name="skv_submitted_date"/>
                                    <field name="skv_response" nolabel="1"
                                        invisible="skv_api_status != 'error'"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- =============================================================
        Search view
        ============================================================= -->
        <record id="view_vaxa_support_filter" model="ir.ui.view">
            <field name="name">vaxa.support.filter</field>
            <field name="model">account.vaxa.support</field>
            <field name="arch" type="xml">
                <search string="Sök Växa-stöd">
                    <field name="name"/>
                    <field name="date_start"/>
                    <field name="date_stop"/>
                    <field name="date" string="Deadline"/>
                    <field name="application_deadline"/>
                    <field name="state"/>
                    <field name="skv_api_status"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter context="{'group_by': 'state'}"
                            name="State" string="Status"/>
                        <filter context="{'group_by': 'date_start'}"
                            name="Period" string="Period"/>
                        <filter context="{'group_by': 'skv_api_status'}"
                            name="SKVStatus" string="SKV Status"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- =============================================================
        List view
        ============================================================= -->
        <record id="view_vaxa_support_tree" model="ir.ui.view">
            <field name="name">vaxa.support.tree</field>
            <field name="model">account.vaxa.support</field>
            <field name="arch" type="xml">
                <list string="Växa-stöd">
                    <field name="name"/>
                    <field name="date"/>
                    <field name="company_id"
                        groups="base.group_multi_company"/>
                    <field name="date_start"/>
                    <field name="date_stop"/>
                    <field name="application_deadline"/>
                    <field name="employee_count"/>
                    <field name="total_reimbursement" widget="monetary"/>
                    <field name="state"/>
                    <field name="skv_api_status" widget="badge"
                        decoration-success="skv_api_status == 'accepted'"
                        decoration-danger="skv_api_status == 'error'"/>
                </list>
            </field>
        </record>

        <!-- =============================================================
        Calendar view
        ============================================================= -->
        <record id="view_vaxa_support_calendar" model="ir.ui.view">
            <field name="name">vaxa.support.calendar</field>
            <field name="model">account.vaxa.support</field>
            <field name="arch" type="xml">
                <calendar date_start="date" string="Växa-stöd">
                    <field name="name"/>
                    <field name="date_start"/>
                    <field name="state"/>
                </calendar>
            </field>
        </record>

        <!-- =============================================================
        Action + Menu
        ============================================================= -->
        <record id="action_vaxa_support" model="ir.actions.act_window">
            <field name="name">Växa-stöd</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">account.vaxa.support</field>
            <field name="view_mode">list,form,calendar</field>
            <field name="search_view_id" ref="view_vaxa_support_filter"/>
        </record>

        <menuitem action="action_vaxa_support"
                  id="menu_vaxa_support"
                  name="Växa-stöd"
                  parent="l10n_se_tax_report.menu_report_authorities"
                  sequence="15"/>

    </data>
</odoo>
