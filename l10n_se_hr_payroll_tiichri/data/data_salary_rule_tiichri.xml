<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Övertidsregler -->
        <record id="hr_salary_rule_kval" model="hr.salary.rule">
            <field name="category_id" ref="tiichri_salary_rule_category_BRUTIL_ti" />
            <field name="company_id" ref="l10n_se_hr_payroll_tiichri.company_aronssons"/>
            <field name="code">kval</field>
            <field name="salary_art">111</field>
            <field name="name">Kvalificerad övertid</field>
            <field name="sequence">115</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = (inputs and inputs.kvaltim and inputs.kvaltim.amount_qty != 0) or False</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
#ML / KO * Antal Kvaltid-timmar
KO = payslip.struct_id.get_constant('KO')
result_qty = inputs.kvaltim.amount_qty
result = contract.wage / KO
            </field>
            <field name="quantity">1</field>
        </record>

        <record id="hr_rule_input_kvaltim" model="hr.rule.input">
            <field name="code">kvaltim</field>
            <field name="name">Kvalificerad övertid (antal timmar)</field>
            <field name="input_id" ref="hr_salary_rule_kval" />
        </record>

