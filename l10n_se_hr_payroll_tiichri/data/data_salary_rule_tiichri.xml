        </record>

        <record id="hr_salary_rule_sick_leave" model="hr.salary.rule">
            <field name="category_id" ref="tiichri_salary_rule_category_BRUTIL_ti" />
            <field name="company_id" ref="l10n_se_hr_payroll_tiichri.company_aronssons"/>
            <field name="code">sick_leave</field>
            <field name="salary_art">550</field>
            <field name="name">Sjukledighet</field>
            <field name="sequence">250</field>
            <field name="appears_on_payslip" eval="False"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = worked_days.dict.get("sick_leave")</field>
            <field name="amount_select">fix</field>
            <field name="quantity">1</field>
            <field name="amount_fix">0</field>
        </record>

        <record id="hr_salary_rule_qualifying_deduction" model="hr.salary.rule">
            <field name="category_id" ref="tiichri_salary_rule_category_BRUAVG_ti" />
            <field name="company_id" ref="l10n_se_hr_payroll_tiichri.company_aronssons"/>
            <field name="parent_rule_id" ref="l10n_se_hr_payroll_tiichri.hr_salary_rule_sick_leave" />
            <field name="code">karensavdrag</field>
            <field name="salary_art">550</field>
            <field name="name">Karensavdrag</field>
            <field name="sequence">242</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_python">result = contract.qualifying_count(payslip)</field>
            <field name="condition_select">python</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# (ML*12)/52 * 0.2 * 0.8
result = (contract.wage*12)/52 * 0.2 * 0.8 * -1
result_qty = contract.qualifying_count(payslip)
            </field>
        </record>

        <record id="hr_salary_rule_sick_deduction_1_14" model="hr.salary.rule">
            <field name="category_id" ref="tiichri_salary_rule_category_BRUAVG_ti" />
            <field name="company_id" ref="l10n_se_hr_payroll_tiichri.company_aronssons"/>
            <field name="parent_rule_id" ref="l10n_se_hr_payroll_tiichri.hr_salary_rule_sick_leave" />
            <field name="code">sjukavdrag_1_14</field>
            <field name="salary_art">550</field>
            <field name="name">Sjukavdrag 1-14</field>
            <field name="sequence">243</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = contract.get_sick_days(payslip) if contract.get_sick_days(payslip) &lt;= 14 and worked_days.dict.get("sick_leave") else False</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# (ML*12)/(52*VA)
VA = payslip.struct_id.get_constant('VA')
result_qty = worked_days.dict.get("sick_leave").number_of_hours
result = (contract.wage*12)/(52*VA)
            </field>
        </record>

        <record id="hr_salary_rule_sick_deduction_15_90" model="hr.salary.rule">
            <field name="category_id" ref="tiichri_salary_rule_category_BRUAVG_ti" />
            <field name="company_id" ref="l10n_se_hr_payroll_tiichri.company_aronssons"/>
            <field name="parent_rule_id" ref="l10n_se_hr_payroll_tiichri.hr_salary_rule_sick_leave" />
            <field name="code">sjukavdrag_15_90</field>
            <field name="salary_art">550</field>
            <field name="name">Sjukavdrag 15-90</field>
            <field name="sequence">244</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = contract.get_sick_days(payslip) if contract.get_sick_days(payslip) &gt;= 15 else False</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
#(ML*12)/365
result = (contract.wage*12)/365
result_qty = contract.get_sick_days(payslip)
            </field>
        </record>

        <record id="hr_salary_rule_bl" model="hr.salary.rule">
            <field name="category_id" ref="tiichri_salary_rule_category_BRUTTO_ti" />
            <field name="company_id" ref="l10n_se_hr_payroll_tiichri.company_aronssons"/>
            <field name="code">bl</field>
            <field name="name">Bruttolön</field>
            <field name="sequence">1000</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# OBS vi räknar plus på allt här då de delar som är avdrag redan är negativa tal.
result = categories.BAS_ti + categories.BRUAVG_ti + categories.BRUTIL_ti
            </field>
            <field name="quantity">1</field>
        </record>

        <record id="hr_salary_rule_sick_wage" model="hr.salary.rule">
            <field name="category_id" ref="tiichri_salary_rule_category_BRUTIL_ti" />
            <field name="company_id" ref="l10n_se_hr_payroll_tiichri.company_aronssons"/>
            <field name="parent_rule_id" ref="l10n_se_hr_payroll_tiichri.hr_salary_rule_sick_leave" />
            <field name="code">sjuklon</field>
            <field name="salary_art">550</field>
            <field name="name">Sjuklön</field>
            <field name="sequence">245</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = contract.get_sick_days(payslip) if contract.get_sick_days(payslip) &lt;= 14 and worked_days.dict.get("sick_leave") else False</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# (ML*12*0.8)/(52*VA)
VA = payslip.struct_id.get_constant('VA')
result_qty = worked_days.dict.get("sick_leave").number_of_hours * -1
result = (contract.wage * 12 * 0.8) / (52 * VA)
            </field>
        </record>

