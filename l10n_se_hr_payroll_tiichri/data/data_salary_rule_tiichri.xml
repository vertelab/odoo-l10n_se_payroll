        <!-- Huvudregel -->
        <record id="hr_salary_rule_leave_of_absence" model="hr.salary.rule">
            <field name="category_id" ref="tiichri_salary_rule_category_BRUTIL_ti" />
            <field name="company_id" ref="l10n_se_hr_payroll_tiichri.company_aronssons"/>
            <field name="code">leave_of_absence</field>
            <field name="salary_art">190</field>
            <field name="name">Tjänstledighet</field>
            <field name="sequence">600</field>
            <field name="appears_on_payslip" eval="False"/>
            <field name="condition_select">python</field>
            <field name="condition_python">
res = contract.split_leave_of_absence_periods(payslip)
result = res['hourly_leave_hours'] &gt; 0 or res['short_leave_days'] &gt; 0 or res['long_leave_calendar_days'] &gt; 0
            </field>
            <field name="amount_select">fix</field>
            <field name="quantity">1</field>
            <field name="amount_fix">0</field>
        </record>

        <!-- Tjänstledighet del av dag -->
        <record id="hr_salary_rule_leave_of_absence_hourly" model="hr.salary.rule">
            <field name="category_id" ref="tiichri_salary_rule_category_BRUAVG_ti" />
            <field name="company_id" ref="l10n_se_hr_payroll_tiichri.company_aronssons"/>
            <field name="parent_rule_id" ref="l10n_se_hr_payroll_tiichri.hr_salary_rule_leave_of_absence" />
            <field name="code">leave_of_absence_hourly</field>
            <field name="salary_art">191</field>
            <field name="name">Tjänstledighet del av dag</field>
            <field name="sequence">610</field>
            <field name="appears_on_payslip" eval="True" />
            <field name="condition_select">python</field>
            <field name="condition_python">
res = contract.split_leave_of_absence_periods(payslip)
result = res['hourly_leave_hours'] &gt; 0
            </field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
#(ML*ANTAL TIMMAR)/175
MAT = payslip.struct_id.get_constant('MAT')
res = contract.split_leave_of_absence_periods(payslip)
result = (contract.wage / MAT)
result_qty = res['hourly_leave_hours'] *-1
            </field>
            <field name="quantity">1</field>
        </record>

