<odoo>
    <data>

        <!--        
VA = Veckoarbetstid                         Weekly Working Hours

http://www.vismaspcs.se/visma-support/visma-lon-special/content/visma-lon-special/semester/semesterlon-vid-andrad-sysselsattningsgrad.htm
APR = Arbetstidsprocent                     Working Percent
ML = Månadslön                              Monthly Salary
SSG = Sysselsättninggrad                    Employment Rate
VAD = Veckoarbetstid dagar heltid           WWH Days Full Time
VADI = Veckoarbetstid dagar intermittent    WWH Days Intermittent
ST = Sjuk Timmar                            Sick Houers
-->

        <record model="hr.work.entry.type" id="holiday_status_sick_leave_code">
            <field name="name" eval="'Sick Leave Code'"/>
            <field name="code">sick_leave</field>
            <field name="external_code" eval="'l10n_se_hr_payroll_tiichri.sick_leave'"/>
            <field name="color">2</field>
            <field name="is_leave" eval="True"/>
            <field name="country_id" ref="base.se"/>
        </record>

        <record model="hr.leave.type" id="holiday_status_sick_leave">
            <field name="name" eval="'Sick Leave'" />
            <field name="work_entry_type_id" ref="l10n_se_hr_payroll_tiichri.holiday_status_sick_leave_code" />
            <field name="color">2</field>
            <field name="legal_leave" eval="True" />
            <field name="limit" eval="False" />
            <field name="company_id" eval="False" />
        </record>

        <record id="hr_salary_rule_sick_leave" model="hr.salary.rule">
            <!-- <field name="category_id" ref="l10n_se_hr_payroll.hr_salary_rule_category-BRUAVG" /> -->
            <field name="code">sickleave</field>
            <field name="salary_art">550</field>
            <field name="name">Sjukledighet</field>
            <field name="company_id" eval="False" />
            <field name="sequence">241</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = worked_days.sickleave if worked_days.sickleave else False</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
result_qty=worked_days.sickleave.number_of_hours 
result=0.0
            </field>
        </record>

        <record id="hr_salary_rule_qualifying_deduction" model="hr.salary.rule">
            <!-- <field name="category_id" ref="l10n_se_hr_payroll.hr_salary_rule_category-BRUAVG" /> -->
            <field name="code">karensavdrag</field>
            <field name="salary_art">550</field>
            <field name="name">Karensavdrag</field>
            <field name="sequence">242</field>
            <field name="company_id" eval="False" />
            <field name="appears_on_payslip" eval="True"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# (ML*12)/52 * 0.2 * 0.8
resulte = (contract.wage*12)/52 * 0.2 * 0.8
            </field>
        </record>

        <record id="hr_salary_rule_sick_deduction_1_14" model="hr.salary.rule">
            <!-- <field name="category_id" ref="l10n_se_hr_payroll.hr_salary_rule_category-BRUAVG" /> -->
            <field name="code">sjukavdrag_1-14</field>
            <field name="salary_art">550</field>
            <field name="name">Sjukavdrag 1-14</field>
            <field name="sequence">243</field>
            <field name="company_id" eval="False" />
            <field name="appears_on_payslip" eval="True"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# (ML*12)/(52*VA)
result = (contract.wage*12)/(52*contract.scheduled_working_hours)
            </field>
        </record>

        <record id="hr_salary_rule_sick_deduction_15_90" model="hr.salary.rule">
            <!-- <field name="category_id" ref="l10n_se_hr_payroll.hr_salary_rule_category-BRUAVG" /> -->
            <field name="code">sjukavdrag_15-90</field>
            <field name="salary_art">550</field>
            <field name="name">Sjukavdrag 15-90</field>
            <field name="sequence">243</field>
            <field name="company_id" eval="False" />
            <field name="appears_on_payslip" eval="True"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
#(ML*12)/365
result = (contract.wage*12)/365
            </field>
        </record>

        <record id="hr_salary_rule_sick_wage" model="hr.salary.rule">
            <!-- <field name="category_id" ref="l10n_se_hr_payroll.hr_salary_rule_category-BRUAVG" /> -->
            <field name="code">sjuklon</field>
            <field name="salary_art">550</field>
            <field name="name">Sjuklön</field>
            <field name="sequence">243</field>
            <field name="company_id" eval="False" />
            <field name="appears_on_payslip" eval="True"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# (ML*12*0.8)/(52*VA)
result = (contract.wage*12*0.8)/(52*contract.scheduled_working_hours)
            </field>
        </record>

    </data>
</odoo>