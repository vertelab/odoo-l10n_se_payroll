        <!-- ============================================ -->
        <!-- GRUNDSTRUKTUR - BAS (Gemensamt för alla)     -->
        <!-- ============================================ -->
        <record id="hr_payroll_structure_gl_tiichri" model="hr.payroll.structure">
            <field name="code">bas</field>
            <field name="name">Bas för löneavtal heltid (Ska ej användas i avtal)</field>
            <field name="company_id" ref="l10n_se_hr_payroll_tiichri.company_aronssons" />
            <field name="rule_ids" eval="[(6,0,[
                ref('l10n_se_hr_payroll.hr_salary_rule_gl'),
                ref('l10n_se_hr_payroll.hr_salary_rule_brutto'),
                ref('l10n_se_hr_payroll.hr_salary_rule_netto'),
                ref('l10n_se_hr_payroll.hr_salary_rule_wage_exchange'),

                ref('l10n_se_hr_payroll.hr_salary_rule_sick_leave'),
                ref('l10n_se_hr_payroll.hr_salary_rule_qualifying_deduction'),
                ref('l10n_se_hr_payroll.hr_salary_rule_sick_wage'),

                ref('l10n_se_hr_payroll.hr_salary_rule_vab'),

                ref('l10n_se_hr_payroll.hr_salary_rule_leave_of_absence'),
                ref('l10n_se_hr_payroll.hr_salary_rule_leave_of_absence_hourly'),
                ref('l10n_se_hr_payroll.hr_salary_rule_leave_of_absence_less_than_5'),
                ref('l10n_se_hr_payroll.hr_salary_rule_leave_of_absence_more_than_5'),

                ref('l10n_se_hr_payroll.hr_salary_rule_kval_otid'),
                ref('l10n_se_hr_payroll.hr_salary_rule_enkel_otid'),
                ref('l10n_se_hr_payroll.hr_salary_rule_bonus'),
                ref('l10n_se_hr_payroll.hr_salary_rule_lunch_parent'),
                ref('l10n_se_hr_payroll.hr_salary_rule_lunch_fmn'),
                ref('l10n_se_hr_payroll.hr_salary_rule_lunch'),
                ref('l10n_se_hr_payroll.hr_salary_rule_reimbursment_parent'),
                ref('l10n_se_hr_payroll.hr_salary_rule_reimbursment'),


                ref('l10n_se_hr_holidays.hr_salary_rule_legal_leave'),
                ref('l10n_se_hr_holidays.hr_salary_rule_saved_leave'),

                ref('l10n_se_hr_holidays.hr_salary_rule_legal_leave_deduction_monthly'),
                ref('l10n_se_hr_holidays.hr_salary_rule_legal_leave_unpaid'),
                ref('l10n_se_hr_holidays.hr_salary_rule_advance_leave'),
                ref('l10n_se_hr_holidays.hr_salary_rule_advance_leave_display'),

            ])]" />

        </record>

        <!-- ============================================ -->
        <!-- TJÄNSTEMAN BAS (parent)                      -->
        <!-- ============================================ -->
        <!-- Konstanterna är satta utifrån heltid, och kommer 
             att justeras av en löneregel när någon har annan 
             sysselsättninggrad.                          -->
        <record id="hr_payroll_structure_tj_base" model="hr.payroll.structure">
            <field name="code">tj_bas</field>
            <field name="name">Tjänsteman Bas</field>
            <field name="parent_id" ref="hr_payroll_structure_gl_tiichri" />
            <field name="company_id" ref="l10n_se_hr_payroll_tiichri.company_aronssons" />
            <field name="rule_ids" eval="[(6,0,[
                ref('l10n_se_hr_payroll.hr_salary_rule_sick_pay_15_90_tj'),
                ref('l10n_se_hr_holidays.hr_salary_rule_legal_leave_addition8'),
                ref('l10n_se_hr_holidays.hr_salary_rule_legal_leave_pay_tj'),
                ref('l10n_se_hr_payroll.hr_salary_rule_mertid'),


            ])]" />
            <field name="const_ids" eval="[
                (0, 0, {'name': 'Månadsarbetstid i timmar heltid', 'code': 'MAT', 'constant': 175.0}),
                (0, 0, {'name': 'Månadsarbetstid i dagar heltid', 'code': 'MAD', 'constant': 21.0}),
                (0, 0, {'name': 'Divisor enkel övertid', 'code': 'EO', 'constant': 94.0}),
                (0, 0, {'name': 'Divisor kvalificerad övertid', 'code': 'KO', 'constant': 72.0}),
                (0, 0, {'name': 'Prisbasbelopp', 'code': 'PBB', 'constant': 483000.0})
            ]" />
        </record>

