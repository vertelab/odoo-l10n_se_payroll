<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Daily cron for work anniversary emails -->
        <record id="cron_work_anniversary_reminder" model="ir.cron">
            <field name="name">HR: Work Anniversary Reminder</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="state">code</field>
            <field name="code">model._cron_work_anniversary_reminder()</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
