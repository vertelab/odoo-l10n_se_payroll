<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Wizard: Ansök om flextidsuttag -->
        <record id="view_hr_flex_request_wizard" model="ir.ui.view">
            <field name="name">hr.flex.request.wizard</field>
            <field name="model">hr.flex.request.wizard</field>
            <field name="arch" type="xml">
                <form string="Ansök om flextidsuttag">
                    <group>
                        <field name="employee_id" invisible="1"/>
                        <field name="request_type"/>
                        <field name="hours"/>
                        <field name="available_hours"/>
                    </group>
                    <group string="Ledighet" attrs="{'invisible': [('request_type', '!=', 'leave')]}">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                    <footer>
                        <button name="action_create_request" string="Skicka ansökan"
                                type="object" class="btn-primary"/>
                        <button string="Avbryt" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
