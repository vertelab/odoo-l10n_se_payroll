<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Utökar tidrapport-vyn -->
        <record id="view_hr_timesheet_sheet_form_inherit_flex" model="ir.ui.view">
            <field name="name">hr.timesheet.sheet.form.inherit.flex</field>
            <field name="model">hr_timesheet.sheet</field>
            <field name="inherit_id" ref="hr_timesheet_sheet.hr_timesheet_sheet_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="inside">
                    <group string="Flextid" name="flex_group">
                        <group>
                            <field name="overtime_hours"/>
                            <field name="undertime_hours"/>
                        </group>
                        <group>
                            <field name="expected_hours"/>
                            <field name="is_overtime_ordered"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
