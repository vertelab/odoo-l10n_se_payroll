<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ITP 1 Plan -->
        <record id="pension_plan_itp1" model="hr.pension.plan">
            <field name="name">ITP 1</field>
            <field name="code">ITP1</field>
            <field name="pension_type">itp1</field>
            <field name="basic_rate">4.5</field>
            <field name="high_rate">30.0</field>
            <field name="sequence">10</field>
        </record>

        <!-- ITP 2 Plan -->
        <record id="pension_plan_itp2" model="hr.pension.plan">
            <field name="name">ITP 2</field>
            <field name="code">ITP2</field>
            <field name="pension_type">itp2</field>
            <field name="basic_rate">4.5</field>
            <field name="high_rate">30.0</field>
            <field name="sequence">20</field>
        </record>

        <!-- SAF-LO Plan -->
        <record id="pension_plan_saflo" model="hr.pension.plan">
            <field name="name">SAF-LO Avtalspension</field>
            <field name="code">SAFLO</field>
            <field name="pension_type">saflo</field>
            <field name="basic_rate">4.5</field>
            <field name="saf_lo_flex_rate">1.0</field>
            <field name="sequence">30</field>
        </record>

        <!-- AKAP-KL Plan -->
        <record id="pension_plan_akap" model="hr.pension.plan">
            <field name="name">AKAP-KL</field>
            <field name="code">AKAP</field>
            <field name="pension_type">akap</field>
            <field name="basic_rate">6.0</field>
            <field name="akap_variable_rate">1.0</field>
            <field name="sequence">40</field>
        </record>

        <!-- ITP 1 bracket: 7.5 IBB limit -->
        <record id="bracket_itp1_basic" model="hr.pension.bracket">
            <field name="plan_id" ref="pension_plan_itp1"/>
            <field name="name">ITP1 — Under 7.5 IBB</field>
            <field name="code">itp1_basic</field>
            <field name="sequence">1</field>
            <field name="wage_from">0</field>
            <field name="wage_to" eval="7.5 * 80600 / 12"/>
            <field name="rate">4.5</field>
        </record>
        <record id="bracket_itp1_high" model="hr.pension.bracket">
            <field name="plan_id" ref="pension_plan_itp1"/>
            <field name="name">ITP1 — Över 7.5 IBB</field>
            <field name="code">itp1_high</field>
            <field name="sequence">2</field>
            <field name="wage_from" eval="7.5 * 80600 / 12"/>
            <field name="rate">30.0</field>
        </record>
    </data>
</odoo>
